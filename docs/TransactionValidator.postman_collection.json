          "graphql": {
            "query": "query RetrieveTransaction($externalId: String!) {\r\n  retrieveTransaction(externalId: $externalId) {\r\n    transactionExternalId\r\n    transactionType {\r\n      id\r\n      name\r\n    }\r\n    transactionStatus {\r\n      id\r\n      name\r\n    }\r\n    value\r\n    createdAt\r\n  }\r\n}",
            "variables": "{\r\n  \"externalId\": \"{{externalId}}\"\r\n}"
          }
        },

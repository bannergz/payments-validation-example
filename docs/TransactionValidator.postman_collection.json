    {
      "name": "Create Transaction",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseBody = pm.response.json();\r",
              "pm.environment.set(\"externalId\", responseBody.data.createTransaction.transactionExternalId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation CreateTransaction($createTransactionInput: CreateTransactionInput!) {\r\n    createTransaction(createTransactionInput: $createTransactionInput) {\r\n    \ttransactionExternalId\r\n        transactionType {\r\n            id\r\n            name\r\n        }\r\n        transactionStatus {\r\n            id\r\n            name\r\n        }  \r\n        value\r\n        createdAt\r\n  }\r\n}",
            "variables": "{\r\n    \"createTransactionInput\" : {\r\n        \"accountExternalIdDebit\": \"{{$guid}}\",\r\n        \"accountExternalIdCredit\": \"{{$guid}}\",\r\n        \"transferTypeId\": 1,\r\n        \"value\": 1000\r\n    }\r\n}"
          }
        },
        "url": {
          "raw": "localhost:3000/graphql",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "graphql"
          ]
        }
      },
      "response": []
    },

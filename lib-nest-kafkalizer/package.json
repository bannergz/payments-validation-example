{
  "name": "lib-nest-kafkalizer",
  "version": "1.0.0",
  "description": "Shared NestJS Kafka library with parametrizable configuration and optional Schema Registry support",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.1.13"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/testing": "^11.1.17",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "ajv": "8.18.0"
  },
  "keywords": [
    "nestjs",
    "kafka",
    "kafkajs",
    "schema-registry",
    "confluent",
    "event-driven",
    "microservices"
  ],
  "author": "",
  "license": "MIT"
}

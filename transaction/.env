KNEX_CLIENT = pg
KNEX_VERSION = 14
KNEX_CONNECTION_HOST = localhost
KNEX_CONNECTION_USER = postgres
KNEX_CONNECTION_PASSWORD = postgres
KNEX_CONNECTION_DATABASE = postgres #Local database, Cloud uses the one u creates in SCRIPT
KNEX_CONNECTION_PORT = 5432
KNEX_CONNECTION_SSL = false

KAFKA_EMITTER_NAME = transaction-emitter 
KAFKA_BROKER = localhost:9092
KAFKA_CONSUMER_GROUP = transaction-consumer

KAFKA_TOPIC_VERIFY_TRANSACTION = verify-transaction
KAFKA_TOPIC_UPDATE_TRANSACTION = update-transaction